# ============= 后端 API =============

# 运行环境: development / production / test
NODE_ENV=development

# API 端口
API_PORT=3001

# Postgres 连接串 (远程云服务器)
# 格式: postgresql://用户名:密码@主机:端口/数据库名?schema=public
DATABASE_URL=postgresql://web3mall:CHANGE_ME@your-cloud-server-ip:5432/web3_mall?schema=public

# Redis 连接串
# 格式: redis://[:密码@]主机:端口[/数据库编号]
REDIS_URL=redis://your-cloud-server-ip:6379

# CORS 允许的前端来源 (开发用)
WEB_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# OTP / 支付演示模式（true=验证码 123456、一键模拟支付）
OTP_MOCK_MODE=true
PAYMENT_MOCK_MODE=true

# 真实支付（配置后 ChannelScaffold 会走 redirect，未配置仍为演示二维码）
# ALIPAY_APP_ID=
# WECHAT_MCH_ID=
# STRIPE_SECRET_KEY=
# PAYPAL_CLIENT_ID=

# 本地调试区域提示：请求头 X-Debug-Country=US 可模拟海外 IP
# Cloudflare 生产环境使用 CF-IPCountry


# ============= 前端 Next.js =============
# NEXT_PUBLIC_ 前缀的变量会被打包到客户端代码, 不要放密钥

# 浏览器调用后端 API 的基础地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
